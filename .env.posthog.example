# PostHog Configuration
# Copy this file to .env.posthog and update with your values

# PostHog Service Configuration
POSTHOG_SECRET_KEY=your-secret-key-here-minimum-32-characters
POSTHOG_SITE_URL=http://localhost:8000

# PostHog API Keys (obtained after initial setup)
# Project API Key - for client-side tracking
NEXT_PUBLIC_POSTHOG_KEY=phc_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=http://localhost:8000

# Personal API Key - for server-side operations
POSTHOG_PERSONAL_API_KEY=phx_personal_api_key

# Backend Service Keys
POSTHOG_PROJECT_API_KEY=phc_project_api_key
POSTHOG_HOST=http://posthog:8000  # Internal Docker network address

# Feature Flags Configuration
POSTHOG_FEATURE_FLAGS_POLLING_INTERVAL=30000  # 30 seconds
POSTHOG_DISABLE_FEATURE_FLAGS=false

# Event Configuration
POSTHOG_BATCH_SIZE=100
POSTHOG_FLUSH_INTERVAL=10000  # 10 seconds
POSTHOG_MAX_QUEUE_SIZE=1000

# Session Recording (optional)
POSTHOG_DISABLE_SESSION_RECORDING=false
POSTHOG_SESSION_RECORDING_SAMPLE_RATE=0.1  # 10% of sessions

# Privacy Configuration
POSTHOG_MASK_ALL_TEXT=false
POSTHOG_MASK_ALL_ELEMENT_ATTRIBUTES=false
POSTHOG_DISABLE_COOKIE=false

# Performance
POSTHOG_CAPTURE_PERFORMANCE=true
POSTHOG_CAPTURE_PAGEVIEW=true

# Debug Mode (development only)
POSTHOG_DEBUG=false

# PCM Integration Settings
POSTHOG_PCM_TRACKING_ENABLED=true
POSTHOG_PCM_STAGE_PROPERTY=pcm_stage
POSTHOG_PCM_HISTORY_PROPERTY=pcm_history
POSTHOG_PCM_SCORE_PROPERTY=pcm_engagement_score

# Experimentation Settings
POSTHOG_EXPERIMENTS_ENABLED=true
POSTHOG_EXPERIMENTS_MINIMUM_SAMPLE_SIZE=50
POSTHOG_EXPERIMENTS_CONFIDENCE_LEVEL=0.95
POSTHOG_EXPERIMENTS_POWER=0.8